[Unit]
Description=CafeDeCafe Cloudflare Tunnel
After=network-online.target imperialax-laminate.service imperialax-injection.service cafedecafe-nangman.service
Wants=network-online.target imperialax-laminate.service imperialax-injection.service cafedecafe-nangman.service

[Service]
Type=simple
ExecStart=%h/.local/bin/cloudflared --config %h/projects/KyulAI/infrastructure/cloudflare/cafedecafe-wsl.yml tunnel run
Restart=always
RestartSec=5
StandardOutput=append:%h/projects/KyulAI/logs/cafedecafe-cloudflared.log
StandardError=append:%h/projects/KyulAI/logs/cafedecafe-cloudflared.err.log

[Install]
WantedBy=default.target
