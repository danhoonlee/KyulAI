# Copy this file to .env.local on the Windows server and fill only what you need.
# Never commit .env.local.

# Required only if Slack slash commands should work.
# SLACK_SIGNING_SECRET=replace_with_slack_signing_secret

# Optional: limit Slack command access to specific user IDs.
# SLACK_ALLOWED_USER_IDS=U0123456789,U9876543210

# Optional local agent bus location. Default is .agent-bus in the project root.
# AGENT_BUS_DIR=C:\KyulAI_codex\.agent-bus

# Development only. Do not use publicly unless you understand the risk.
# SLACK_ALLOW_UNSIGNED_COMMANDS=0
